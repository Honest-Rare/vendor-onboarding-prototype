{
  "name": "@hr/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,node \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:migrate": "tsc -p tsconfig.json && node --env-file-if-exists=../../.env dist/db/migrate.js",
    "db:seed": "tsc -p tsconfig.json && node --env-file-if-exists=../../.env dist/db/seed.js",
    "db:reset": "tsc -p tsconfig.json && node --env-file-if-exists=../../.env dist/db/migrate.js --reset && node --env-file-if-exists=../../.env dist/db/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  }
}
