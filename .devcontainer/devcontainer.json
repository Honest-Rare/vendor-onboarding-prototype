{
  "name": "Vendor onboarding pre-prototype",
  "dockerComposeFile": ["docker-compose.devcontainer.yml"],
  "service": "app",
  "initializeCommand": "docker build -t hr-onboarding-dev:local .devcontainer",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Web (storefront, admin, vendor panel)" }
  },
  "postCreateCommand": "`npm install`",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
