# Copy this file to .env and fill in what you need. Never commit .env.

# Database (Postgres 18, started by docker compose / the dev container)
DATABASE_URL=postgres://onboarding:onboarding@localhost:55432/onboarding

# Where the web app runs (used in email links)
WEB_BASE_URL=http://localhost:3000
API_PORT=4000

# Email goes to Mailpit, a local test inbox: http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM="Honest & Rare <onboarding@honest-rare.test>"
ADMIN_NOTIFY_EMAIL=admin@honest-rare.test

# Admin login for the admin console (created on seed)
ADMIN_EMAIL=admin@honest-rare.test
ADMIN_PASSWORD=change-me-admin

# Stripe Connect (Express). Leave empty to use the simulated Stripe.
# Only TEST keys are accepted (sk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=

# AI screening provider: "simulated" until a Bedrock or Anthropic key exists
AI_PROVIDER=simulated

# Real VAT check against the EU VIES service (free, no key). Set to false offline.
VIES_ENABLED=true

# Uploaded photos and documents
UPLOAD_DIR=./data/uploads

# Version of the vendor terms applicants accept; change it whenever the terms text changes
TERMS_VERSION=draft-1
